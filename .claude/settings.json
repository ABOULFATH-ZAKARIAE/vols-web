{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run format:check)",
      "Bash(npm audit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx expo install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel:*)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)",
      "Bash(npm run deploy:*)",
      "Bash(nest deploy:*)"
    ]
  }
}
